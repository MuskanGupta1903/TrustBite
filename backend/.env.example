# TrustBite Backend Environment Variables
# Create a .env file locally with your secrets. Do NOT commit .env.

# Required: Google Gemini API Key
GEMINI_API_KEY=

# Required: Gemini Model (defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Optional: Port to run the server on (defaults to 3001 locally)
PORT=3001
